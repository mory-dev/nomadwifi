<Window x:Class="NomadWiFi.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NomadWiFi - Hotel &amp; Travel Roaming Optimizer"
        Height="700" Width="840"
        MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, -apple-system, Roboto, Helvetica, Arial">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Dark TitleBar -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBg}" MouseDown="TitleBar_MouseDown">
                <!-- Title & Icon -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="🧭" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="NomadWiFi" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Caption Buttons (Minimize, Maximize, Close) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Content="—" Style="{StaticResource CaptionBtn}" Click="BtnMinimize_Click" ToolTip="Minimize" />
                    <Button x:Name="BtnMaximize" Content="▢" Style="{StaticResource CaptionBtn}" Click="BtnMaximize_Click" ToolTip="Maximize" />
                    <Button Content="✕" Style="{StaticResource CloseCaptionBtn}" Click="BtnClose_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Main Body Content -->
            <Grid Grid.Row="1" Margin="24,14,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Row -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧭" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Nomad" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        <TextBlock Text="WiFi" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" />
                        <Border Background="#10B98122" BorderBrush="#10B98144" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Hotel Auto-Roam" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" />
                        </Border>
                    </StackPanel>

                    <Button Content="🔄 Refresh" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Right" Click="BtnRefresh_Click" Padding="12,6" FontSize="12" />
                </Grid>

                <!-- Active Hero Connection Card -->
                <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Row: SSID & Band Tag -->
                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock x:Name="TxtSsid" Text="Detecting Connection..." FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="TxtDetails" Text="Querying wireless adapter..." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border x:Name="BorderBand" Background="#10B98122" BorderBrush="#10B98144" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBand" Text="5 GHz (802.11ac)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" />
                            </Border>
                        </Grid>

                        <!-- Middle Row: Metrics Grid -->
                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,0">
                            <Border Background="#121822" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtSignal" Text="-- %" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Signal Strength" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#121822" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4,0,4,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtSpeed" Text="-- Mbps" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Link Speed" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="#121822" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtLatency" Text="-- ms" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Gateway Latency" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Action Button Row -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BtnOptimize" Content="⚡ Auto-Optimize 5GHz" Style="{StaticResource PrimaryBtn}" Click="BtnOptimize_Click" />
                            <TextBlock x:Name="TxtStatusMsg" Text="" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Access Points List Card -->
                <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- List Header -->
                        <Grid Grid.Row="0" Margin="4,0,4,12">
                            <TextBlock Text="Discovered Access Points (Ranked by Quality Score)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="TxtApCount" Text="Scanning..." FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- AP List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsAccessPoints">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#121822" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <!-- SSID & MAC -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ssid}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="{Binding bssid}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Band Tag -->
                                                <Border Grid.Column="1" Background="#3B82F622" BorderBrush="#3B82F644" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BandTag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" />
                                                </Border>

                                                <!-- Radio -->
                                                <TextBlock Grid.Column="2" Text="{Binding radio_type}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />

                                                <!-- Signal -->
                                                <TextBlock Grid.Column="3" Text="{Binding SignalDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />

                                                <!-- Score Progress -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ProgressBar Value="{Binding quality_score}" Maximum="100" Width="40" Height="6" Background="#283344" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ScoreDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </StackPanel>

                                                <!-- Connect Button -->
                                                <Button Grid.Column="5" Content="Connect" Style="{StaticResource SecondaryBtn}" Padding="8,4" FontSize="11" Click="BtnConnect_Click" Tag="{Binding ssid}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Footer Card -->
                <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Hotel Auto-Roam Watcher is active in background" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="NomadWiFi v1.0" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
