<Window x:Class="NomadWiFi.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NomadWiFi - Hotel &amp; Travel Roaming Optimizer"
        Height="730" Width="880"
        MinHeight="580" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0D1117"
        Foreground="#F0F6FC"
        FontFamily="Segoe UI, -apple-system, Roboto, Helvetica, Arial">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#0D1117" />
        <SolidColorBrush x:Key="TitleBarBg" Color="#161B22" />
        <SolidColorBrush x:Key="CardBg" Color="#161B22" />
        <SolidColorBrush x:Key="CardBorder" Color="#30363D" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF" />
        <SolidColorBrush x:Key="AccentYellow" Color="#D29922" />
        <SolidColorBrush x:Key="AccentRed" Color="#F85149" />
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7" />

        <!-- TitleBar Window Caption Buttons -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Caption Button -->
        <Style x:Key="CloseCaptionBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DA3633" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Fluent Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10B981" Offset="0" />
                        <GradientStop Color="#059669" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Fluent Button Style -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Dark TitleBar -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBg}" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="🧭" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Nomad" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="WiFi" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" />
                    <Border Background="#10B98122" BorderBrush="#10B98144" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Hotel Auto-Roam" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" />
                    </Border>
                </StackPanel>

                <!-- Right Side: Caption Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Content="—" Style="{StaticResource CaptionBtn}" Click="BtnMinimize_Click" ToolTip="Minimize" />
                    <Button x:Name="BtnMaximize" Content="▢" Style="{StaticResource CaptionBtn}" Click="BtnMaximize_Click" ToolTip="Maximize" />
                    <Button Content="✕" Style="{StaticResource CloseCaptionBtn}" Click="BtnClose_Click" ToolTip="Minimize to System Tray" />
                </StackPanel>
            </Grid>

            <!-- Main Body Content -->
            <Grid Grid.Row="1" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Captive Portal Alert Banner (Appears when hotel login page is intercepted) -->
                <Border x:Name="BorderCaptivePortal" Grid.Row="0" Visibility="Collapsed" Background="#D2992222" BorderBrush="#D29922" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Hotel Web Login Intercepted — Guest portal authentication is required." FontWeight="SemiBold" Foreground="#F0883E" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="🔑 Open Hotel Login Page" Style="{StaticResource SecondaryBtn}" Padding="10,4" FontSize="11" HorizontalAlignment="Right" Click="BtnOpenCaptive_Click" />
                    </Grid>
                </Border>

                <!-- 2. Roam Upgrade Celebration Banner -->
                <Border x:Name="BorderRoamCelebration" Grid.Row="0" Visibility="Collapsed" Background="#10B98122" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎉" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtRoamCelebrationMsg" Text="Auto-Roamed to 5 GHz! Speed upgraded from 54 Mbps ➔ 351 Mbps (6.5x faster)" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" Style="{StaticResource CaptionBtn}" Width="24" Height="24" HorizontalAlignment="Right" Click="BtnDismissCelebration_Click" />
                    </Grid>
                </Border>

                <!-- Active Hero Connection Card with Real-Time Latency Sparkline -->
                <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Row: SSID & Band Tag -->
                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock x:Name="TxtSsid" Text="Detecting Connection..." FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="TxtDetails" Text="Querying wireless adapter..." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border x:Name="BorderBand" Background="#10B98122" BorderBrush="#10B98144" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBand" Text="5 GHz (802.11ac)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" />
                            </Border>
                        </Grid>

                        <!-- Middle Row: Metrics Grid + Real-Time Jitter Sparkline -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2.2*" />
                            </Grid.ColumnDefinitions>

                            <!-- Signal Metric -->
                            <Border Grid.Column="0" Background="#121822" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtSignal" Text="-- %" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Signal Strength" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Link Speed Metric -->
                            <Border Grid.Column="1" Background="#121822" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="3,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtSpeed" Text="-- Mbps" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Link Speed" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Gateway Latency & Real-Time Sparkline -->
                            <Border Grid.Column="2" Background="#121822" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtLatency" Text="-- ms" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="TxtJitter" Text="Jitter: -- ms" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Canvas x:Name="CanvasSparkline" Grid.Column="1" Height="32" VerticalAlignment="Center" ClipToBounds="True">
                                        <Polygon x:Name="PolygonSparklineArea" Fill="#10B98122" />
                                        <Polyline x:Name="PolylineSparkline" Stroke="#10B981" StrokeThickness="2" />
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Action Button Row with Rich Explanatory Hover ToolTip -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnOptimize" Content="⚡ Auto-Optimize 5GHz" Style="{StaticResource PrimaryBtn}" Click="BtnOptimize_Click">
                                <Button.ToolTip>
                                    <ToolTip Background="#161B22" BorderBrush="#30363D" BorderThickness="1" Foreground="#F0F6FC" Padding="14,12">
                                        <StackPanel MaxWidth="320">
                                            <TextBlock Text="⚡ What does Auto-Optimize do?" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,6" />
                                            <TextBlock Text="• Scans all nearby Wi-Fi access points in your hotel / venue." FontSize="11" Foreground="#C9D1D9" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Text="• Identifies high-speed 5 GHz &amp; 6 GHz channels with superior signal &amp; cipher." FontSize="11" Foreground="#C9D1D9" TextWrapping="Wrap" Margin="0,2" />
                                            <TextBlock Text="• Pre-warms hot-standby profiles for instantaneous failover roaming." FontSize="11" Foreground="#C9D1D9" TextWrapping="Wrap" Margin="0,2" />
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                            <TextBlock x:Name="TxtStatusMsg" Text="" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Access Points List Card (Expanded Vertical Area) -->
                <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- List Header -->
                        <Grid Grid.Row="0" Margin="4,0,4,10">
                            <TextBlock Text="Discovered Access Points (Ranked by Quality &amp; Accessibility)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="TxtApCount" Text="Scanning..." FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- AP List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsAccessPoints">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#121822" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="75" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="65" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="75" />
                                                </Grid.ColumnDefinitions>

                                                <!-- SSID & MAC -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ssid}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text=" 🔥 Warmed" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Visibility="{Binding WarmVisibility}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Pre-warmed in Windows for instant zero-lag failover" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding bssid}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Band Tag -->
                                                <Border Grid.Column="1" Background="#3B82F622" BorderBrush="#3B82F644" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BandTag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" />
                                                </Border>

                                                <!-- Auth Badge (Saved / Hotel Key / Open / Locked) -->
                                                <Border Grid.Column="2" Background="{Binding AuthBadgeBrush}" BorderBrush="{Binding AuthBadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AuthBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AuthBadgeTextBrush}" />
                                                </Border>

                                                <!-- Radio -->
                                                <TextBlock Grid.Column="3" Text="{Binding radio_type}" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />

                                                <!-- Signal -->
                                                <TextBlock Grid.Column="4" Text="{Binding SignalDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />

                                                <!-- Score Progress -->
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ProgressBar Value="{Binding quality_score}" Maximum="100" Width="36" Height="6" Background="#283344" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ScoreDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                                </StackPanel>

                                                <!-- Connect Button -->
                                                <Button Grid.Column="6" Content="{Binding ConnectBtnText}" IsEnabled="{Binding CanConnect}" Style="{StaticResource SecondaryBtn}" Padding="8,4" FontSize="11" Click="BtnConnect_Click" Tag="{Binding ssid}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Footer Card with Autonomous Watchdog & Startup Controls -->
                <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,9">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkAutoRoam" Content="🛡️ Autonomous Auto-Roam Watchdog" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0" Click="ChkAutoRoam_Click" ToolTip="Silently monitors signal &amp; latency in the background and auto-switches to 5GHz when needed" />
                            <CheckBox x:Name="ChkStartup" Content="🚀 Start with Windows" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Click="ChkStartup_Click" ToolTip="Automatically start NomadWiFi minimized to system tray on boot" />
                        </StackPanel>
                        <TextBlock Text="NomadWiFi v1.1 • Enterprise" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
