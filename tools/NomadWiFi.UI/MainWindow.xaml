<Window x:Class="NomadWiFi.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NomadWiFi"
        Height="760" Width="900"
        MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0D1117"
        Foreground="#F0F6FC"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI, -apple-system, Roboto, Helvetica, Arial">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0D1117" />
        <SolidColorBrush x:Key="TitleBarBg" Color="#161B22" />
        <SolidColorBrush x:Key="CardBg" Color="#161B22" />
        <SolidColorBrush x:Key="CardInner" Color="#121822" />
        <SolidColorBrush x:Key="CardBorder" Color="#30363D" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F6FC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E" />
        <!-- Brand blue comes from the logo; green is kept strictly for
             "this is healthy" so a status badge still reads at a glance. -->
        <SolidColorBrush x:Key="AccentBrand" Color="#189CF0" />
        <SolidColorBrush x:Key="AccentBrandDeep" Color="#0C60CC" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF" />
        <SolidColorBrush x:Key="AccentYellow" Color="#D29922" />
        <SolidColorBrush x:Key="AccentRed" Color="#F85149" />
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7" />

        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseCaptionBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DA3633" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1890F0" Offset="0" />
                        <GradientStop Color="#0B57C8" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource TitleBarBg}" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image x:Name="ImgBrandMark" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Nomad" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Text="WiFi" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrand}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Content="—" Style="{StaticResource CaptionBtn}" Click="BtnMinimize_Click" ToolTip="Minimise" />
                    <Button x:Name="BtnMaximize" Content="□" Style="{StaticResource CaptionBtn}"
                            Click="BtnMaximize_Click" ToolTip="Maximise" />
                    <Button Content="✕" Style="{StaticResource CloseCaptionBtn}" Click="BtnClose_Click"
                            ToolTip="Close to the system tray" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Offline -->
                <Border x:Name="BorderOfflineBanner" Grid.Row="0" Visibility="Collapsed"
                        Background="#22F85149" BorderBrush="#F85149" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtOfflineBanner"
                               Text="Not connected. Choose a network below to get online."
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" Foreground="#F85149" FontSize="12" />
                </Border>

                <!-- Captive portal -->
                <Border x:Name="BorderCaptivePortal" Grid.Row="1" Visibility="Collapsed"
                        Background="#22D29922" BorderBrush="#D29922" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtCaptiveMsg" Grid.Column="0" TextWrapping="Wrap"
                                   Text="This network needs a web login before you can get online."
                                   FontWeight="SemiBold" Foreground="#F0883E" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnPauseVpnAndLogin" Content="Pause VPN and sign in"
                                    Style="{StaticResource SecondaryBtn}" Visibility="Collapsed"
                                    Margin="0,0,8,0" Click="BtnPauseVpnAndLogin_Click" />
                            <Button Content="Open the login page" Style="{StaticResource SecondaryBtn}"
                                    Click="BtnOpenCaptive_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Roam notice -->
                <Border x:Name="BorderRoamCelebration" Grid.Row="2" Visibility="Collapsed"
                        Background="#2210B981" BorderBrush="#10B981" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock x:Name="TxtRoamCelebrationMsg" TextWrapping="Wrap"
                                   Text="Moved to a faster access point."
                                   FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,30,0" />
                        <Button Content="✕" Style="{StaticResource CaptionBtn}" Width="24" Height="24"
                                HorizontalAlignment="Right" Click="BtnDismissCelebration_Click" />
                    </Grid>
                </Border>

                <!-- Current connection -->
                <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock x:Name="TxtSsid" Text="Checking your connection..." FontSize="21"
                                           FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="TxtDetails" Text="Reading the wireless adapter" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border x:Name="BorderBand" Background="#2258A6FF" BorderBrush="#4458A6FF"
                                    BorderThickness="1" CornerRadius="8" Padding="10,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBand" Text="--" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlue}" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="2.4*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource CardInner}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSignal" Text="--" Style="{StaticResource MetricValue}" />
                                    <TextBlock x:Name="TxtSignalSub" Text="Signal" Style="{StaticResource MetricLabel}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource CardInner}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="10" Margin="3,0,6,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSpeed" Text="--" Style="{StaticResource MetricValue}" />
                                    <TextBlock Text="Link speed" Style="{StaticResource MetricLabel}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource CardInner}"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,8" Margin="3,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtLatency" Text="--" FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="TxtJitter" Text="Latency to your router" FontSize="10"
                                                   Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Canvas x:Name="CanvasSparkline" Grid.Column="1" Height="34"
                                            VerticalAlignment="Center" ClipToBounds="True">
                                        <Polygon x:Name="PolygonSparklineArea" Fill="#22189CF0" />
                                        <Polyline x:Name="PolylineSparkline" Stroke="#189CF0" StrokeThickness="2" />
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="BtnOptimize" Content="Switch to the best access point"
                                    Style="{StaticResource PrimaryBtn}" Click="BtnOptimize_Click" />
                            <TextBlock x:Name="TxtStatusMsg" Text="" Foreground="{StaticResource AccentBrand}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"
                                       FontSize="12" TextWrapping="Wrap" MaxWidth="470" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- VPN -->
                <Border x:Name="BorderVpn" Grid.Row="4" Visibility="Collapsed"
                        Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtVpnProvider" Text="VPN" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="TxtVpnState" Text="" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="TxtVpnHint" Text="" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,4,12,0" />
                        </StackPanel>
                        <Button x:Name="BtnVpnPause" Grid.Column="1" Content="Pause VPN"
                                Style="{StaticResource SecondaryBtn}" VerticalAlignment="Center"
                                Visibility="Collapsed" Click="BtnVpnPause_Click" />
                    </Grid>
                </Border>

                <!-- Networks -->
                <Border Grid.Row="5" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,10">
                            <TextBlock Text="Networks in range" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="TxtApCount" Text="Scanning" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsAccessPoints">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardInner}"
                                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,9" Margin="0,0,0,7"
                                                ToolTip="{Binding ReasonTooltip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="98" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <!-- A Grid, not a StackPanel, and the name column star-sized: a
                                                         horizontal StackPanel (or an Auto column) gives its child
                                                         unbounded width, so a long SSID pushed the badge out over the
                                                         band column. Star-sizing constrains the name so it ellipsizes
                                                         and the badge always stays inside the column. -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ssid}" FontWeight="SemiBold"
                                                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ssid}" />
                                                        <TextBlock Grid.Column="1" Text="prepared by NomadWiFi" FontSize="10" FontWeight="Bold"
                                                                   Foreground="#F59E0B" Visibility="{Binding WarmVisibility}"
                                                                   Margin="8,0,8,0" VerticalAlignment="Center"
                                                                   ToolTip="NomadWiFi worked out the key and prepared this profile, so switching here is instant" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding bssid}" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondary}" />
                                                        <TextBlock Text="{Binding RadioCountDisplay}" FontSize="11"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   Visibility="{Binding RadioCountVisibility}" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding BandTag}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{Binding BandBrush}"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="2" Background="{Binding AuthBadgeBrush}"
                                                        BorderBrush="{Binding AuthBadgeBorderBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="7,2" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AuthBadgeText}" FontSize="11"
                                                               FontWeight="SemiBold" Foreground="{Binding AuthBadgeTextBrush}" />
                                                </Border>

                                                <TextBlock Grid.Column="3" Text="{Binding radio_type}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="4" Text="{Binding SignalDisplay}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="5" Text="{Binding ScoreDisplay}" FontSize="13"
                                                           FontWeight="Bold" Foreground="{StaticResource AccentGreen}"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Column="6" Content="{Binding ConnectBtnText}"
                                                        Style="{StaticResource SecondaryBtn}" Padding="10,5" FontSize="11"
                                                        Click="BtnConnect_Click" Tag="{Binding ssid}"
                                                        HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="6" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="14,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkAutoRoam" Content="Roam automatically"
                                      Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12"
                                      VerticalAlignment="Center" Margin="0,0,18,0" Click="ChkAutoRoam_Click"
                                      ToolTip="Watches signal, latency and loss, and moves you when the connection degrades or drops" />
                            <CheckBox x:Name="ChkStartup" Content="Start with Windows"
                                      Foreground="{StaticResource TextSecondary}" FontSize="12"
                                      VerticalAlignment="Center" Click="ChkStartup_Click"
                                      ToolTip="Start minimised to the system tray when you sign in" />
                        </StackPanel>
                        <TextBlock x:Name="TxtActivity" Grid.Column="1" Text="" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Password prompt -->
            <Grid x:Name="OverlayPasswordModal" Grid.Row="0" Grid.RowSpan="2" Background="#CC0D1117"
                  Visibility="Collapsed">
                <Border Background="#161B22" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="24" Width="430" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Wi-Fi password" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock x:Name="TxtModalSsid" Text="" FontSize="12"
                                   Foreground="{StaticResource AccentBrand}" FontWeight="SemiBold"
                                   Margin="0,4,0,16" />
                        <PasswordBox x:Name="BoxPassword" Height="34" FontSize="14" Background="#0D1117"
                                     Foreground="#F0F6FC" BorderBrush="#30363D" BorderThickness="1"
                                     Padding="8,6" KeyDown="BoxPassword_KeyDown" />
                        <TextBlock x:Name="TxtModalError" Text="" Foreground="{StaticResource AccentRed}"
                                   FontSize="11" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="Cancel" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                                    Padding="14,7" Click="BtnCancelPassword_Click" />
                            <Button x:Name="BtnSavePassword" Content="Connect" Style="{StaticResource PrimaryBtn}"
                                    Padding="18,7" Click="BtnSavePassword_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
